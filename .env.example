# Copier vers .env puis renseigner les secrets localement.
# Chargement explicite : uv run --env-file .env rne-ingest --help
# Ne jamais intégrer .env dans l'image ni placer ses valeurs dans OpenTofu.
# Voir docs/rne/inpi.md et docs/rne/inpi-ingestion.md.

# API RNE — compte personnel E-procédures ; JWT obtenu à la connexion.
INPI_USERNAME=your-email@example.com
INPI_PASSWORD='replace-with-your-personal-password'

# FTP de stock — couple technique fourni dans l'espace DATA INPI.
# Ne pas utiliser le mot de passe personnel sur ce service FTP non chiffré.
INPI_FTP_HOST=www.inpi.net
INPI_FTP_PORT=21
INPI_FTP_USERNAME=replace-with-your-technical-ftp-login
INPI_FTP_PASSWORD='replace-with-your-technical-ftp-password'

# SFTP documentaire — accès non validé pendant l'exploration.
# La documentation indique le compte E-procédures, pas le couple technique FTP.
INPI_SFTP_HOST=registre-national-entreprises.inpi.fr
INPI_SFTP_PORT=9222
INPI_SFTP_USERNAME=your-email@example.com
INPI_SFTP_PASSWORD='replace-with-your-personal-password'

# Destination GCS (ADC) ; choisir un namespace personnel pour les essais.
RNE_BUCKET=industrial-intelligence-dev-data
RNE_PREFIX=sandbox/change-me/inpi/rne

# Stock FTP à archiver (bootstrap). La borne du différentiel est passée à sync --start.
RNE_STOCK_FILE=
